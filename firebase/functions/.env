# Non-secret settings for the App Testing functions. Secrets (Stripe key, webhook secret, Resend key)
# are in Firebase Secret Manager, never here.
MAIL_FROM=Civil Digital <bookings@civildigital.co.uk>

# ---- SANDBOX TESTING PHASE: change all of this at go-live (see firebase/README.md) ----
# Where Stripe sends customers after paying or cancelling. Go-live: https://civildigital.co.uk
SITE_URL=http://localhost:8080
# Extra origins allowed to call the booking function. Go-live: leave empty.
EXTRA_ORIGINS=http://localhost:8080
# Stripe price IDs (sandbox). Go-live: replace with the live price IDs.
PRICE_QUICK_CHECK=price_1UOdXIQfTNzLg3RkBxT2KyB8
PRICE_FEATURE_TEST=price_1UOdXKQfTNzLg3RkncfSYdB3
PRICE_EXTRA_JOURNEY=price_1UOdXNQfTNzLg3RkWn0YXTBM
PRICE_ROLLING=price_1UOdXPQfTNzLg3Rk2mb2zdQ5
PRICE_LAUNCH_PACK=price_1UOdXRQfTNzLg3Rkg958aGBa

# Paid bookings allowed before "full". Raise by one to reopen a space.
ROLLING_LIMIT=5
LAUNCH_PACK_LIMIT=5
