# Non-secret settings for the App Testing functions. Secrets (Stripe key, webhook secret, Resend key)
# are in Firebase Secret Manager, never here.
MAIL_FROM=Civil Digital <bookings@civildigital.co.uk>

# ---- LIVE (switched 2026-10-09) ----
# Where Stripe sends customers after paying or cancelling.
SITE_URL=https://civildigital.co.uk
# Extra origins allowed to call the booking function, comma-separated (e.g. http://localhost:8080 for a
# sandbox test). Keep empty in live.
EXTRA_ORIGINS=
# Stripe price IDs, live account (Civil Digital Services). Fix re-check (not used by the site):
# price_1UOfpMQeMXeU9ocQ2XqlEjDd
PRICE_QUICK_CHECK=price_1UOfpFQeMXeU9ocQxQ7mZQkw
PRICE_FEATURE_TEST=price_1UOfpGQeMXeU9ocQX1BkjKAb
PRICE_EXTRA_JOURNEY=price_1UOfpHQeMXeU9ocQ2W12EDdt
PRICE_ROLLING=price_1UOfpJQeMXeU9ocQaEnz846E
PRICE_LAUNCH_PACK=price_1UOfpKQeMXeU9ocQBKBHUEHb

# Paid bookings allowed before "full". Raise by one to reopen a space, then redeploy.
ROLLING_LIMIT=5
LAUNCH_PACK_LIMIT=5
